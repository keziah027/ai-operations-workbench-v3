# 复制为 secrets.toml 后在本机填写。不要把密钥发到聊天或分享压缩包。
OPENAI_API_KEY = "your-api-key"
# 文档确认支持 Responses 与结构化输出；模型权限以你的 API 项目为准。
OPENAI_MODEL = "gpt-4.1-mini"
OPENAI_TIMEOUT = 60
OPENAI_MAX_OUTPUT_TOKENS = 6500
# 输入按字符限制，不是精确 token 费用预估。
AI_MAX_INPUT_CHARS = 60000
AI_MAX_NOTES = 24
AI_BODY_CHARS = 500
AI_HISTORY_TURNS = 4
